{
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "es2020",
    "strict": true
  },
  "exclude": [
    "node_Modules",
    "tests/__coverage__",
    "tests/__mocks__",
    "dist",
    "configs"
  ]
}
